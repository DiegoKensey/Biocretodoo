<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- v19.0.1.3.0: los asesores no envían cotizaciones por correo desde
         Odoo. Estas dos acciones del menú Acción de sale.order
         (sale/views/sale_order_views.xml:1205-1212 y :1223-1234) quedan
         reservadas al grupo técnico Administración / Ajustes.

         Por qué group_ids y no desvincular binding_model_id: el registro
         nativo SÍ define binding_model_id, así que un `-u sale` lo
         restauraría. En cambio NO define group_ids (verificado en ese
         XML), de modo que `-u sale` no lo toca. El menú Acción filtra
         por group_ids en ir.actions.actions.get_bindings
         (base/models/ir_actions.py:167-168).

         "Share" y "Generar enlace de pago" se quedan como están. -->
    <record id="sale.model_sale_order_action_quotation_sent" model="ir.actions.server">
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
    </record>

    <record id="sale.model_sale_order_send_mail" model="ir.actions.server">
        <field name="group_ids" eval="[Command.set([ref('base.group_system')])]"/>
    </record>

</odoo>
