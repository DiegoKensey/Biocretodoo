<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_biocreto_medio_pago_list" model="ir.ui.view">
        <field name="name">biocreto.medio.pago.list</field>
        <field name="model">biocreto.medio.pago</field>
        <field name="arch" type="xml">
            <list string="Medios de Pago" editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_biocreto_medio_pago" model="ir.actions.act_window">
        <field name="name">Medios de pago</field>
        <field name="res_model">biocreto.medio.pago</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Cree los medios de pago para sus órdenes de compra.
            </p>
        </field>
    </record>

    <menuitem id="menu_biocreto_pagos_section"
              name="Pagos"
              parent="purchase.menu_purchase_config"
              sequence="99"/>

    <menuitem id="menu_biocreto_medio_pago"
              name="Medios de pago"
              parent="menu_biocreto_pagos_section"
              action="action_biocreto_medio_pago"
              sequence="10"/>

</odoo>
