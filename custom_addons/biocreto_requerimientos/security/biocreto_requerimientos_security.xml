<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        En v19 la seccion de la pestana de accesos del usuario la determina
        res.groups.privilege.category_id (res.groups ya NO tiene category_id).
        Ver odoo/addons/base/models/res_groups_privilege.py:4-14 y
        odoo/addons/base/models/res_groups.py:320-354 (_get_view_group_hierarchy).
        base.module_category_supply_chain = "Cadena de suministro" (es_PE).
    -->
    <record model="res.groups.privilege" id="res_groups_privilege_requerimientos">
        <field name="name">Requerimientos</field>
        <field name="sequence">30</field>
        <field name="category_id" ref="base.module_category_supply_chain"/>
    </record>

    <record id="group_requerimiento_solicitante" model="res.groups">
        <field name="name">Solicitante</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_requerimientos"/>
        <field name="implied_ids" eval="[(6, 0, [ref('base.group_user')])]"/>
        <field name="comment">Puede crear y seguir sus propios requerimientos.</field>
    </record>

    <record id="group_requerimiento_user" model="res.groups">
        <field name="name">Encargado de solicitudes</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_requerimientos"/>
        <field name="implied_ids" eval="[(4, ref('group_requerimiento_solicitante'))]"/>
        <field name="comment">Atiende los requerimientos de toda la planta.</field>
    </record>

    <record id="group_requerimiento_manager" model="res.groups">
        <field name="name">Administrador</field>
        <field name="sequence">30</field>
        <field name="privilege_id" ref="res_groups_privilege_requerimientos"/>
        <field name="implied_ids" eval="[(4, ref('group_requerimiento_user'))]"/>
        <field name="comment">Configura las categorías de requerimiento.</field>
    </record>

    <!--
        v19.0.3.0.0 — VALIDADOR DE BAJAS DE INVENTARIO.

        Grupo PROPIO y no uno de los tres existentes: «jefe de area» no
        es un rol funcional del modulo (quien pide / quien atiende /
        quien configura) sino una relacion con UN departamento concreto,
        y eso un grupo no lo sabe.

        Nace VACIO y lo implica `group_requerimiento_manager`, asi que
        HOY validan los administradores —lo que pide el encargo— y el dia
        que exista la figura real basta con meter gente en este grupo:
        el codigo pregunta SOLO por el (`_biocreto_exigir_validador`) y
        NO cambia.

        Implica a su vez a `group_requerimiento_user` porque un validador
        tiene que poder abrir los conteos que valida.

        Si algun dia cada jefe debe validar SOLO su area, eso es una
        ir.rule sobre `department_id`, no otro grupo.
    -->
    <record id="group_inventario_validador" model="res.groups">
        <field name="name">Validador de inventario de activos</field>
        <field name="sequence">25</field>
        <field name="privilege_id" ref="res_groups_privilege_requerimientos"/>
        <field name="implied_ids" eval="[(4, ref('group_requerimiento_user'))]"/>
        <field name="comment">Valida o rechaza los conteos de activos y sus bajas de inventario.</field>
    </record>

    <record id="group_requerimiento_manager" model="res.groups">
        <field name="implied_ids" eval="[(4, ref('group_inventario_validador'))]"/>
    </record>

    <data noupdate="1">

        <!-- ── Solicitante: solo lo suyo ────────────────────────────── -->
        <record id="requerimiento_rule_propias" model="ir.rule">
            <field name="name">Requerimiento: propias (solicitante)</field>
            <field name="model_id" ref="model_biocreto_requerimiento"/>
            <field name="groups" eval="[(4, ref('group_requerimiento_solicitante'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">[('solicitante_id', '=', user.id)]</field>
        </record>

        <record id="requerimiento_linea_rule_propias" model="ir.rule">
            <field name="name">Línea de requerimiento: propias (solicitante)</field>
            <field name="model_id" ref="model_biocreto_requerimiento_linea"/>
            <field name="groups" eval="[(4, ref('group_requerimiento_solicitante'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[('requerimiento_id.solicitante_id', '=', user.id)]</field>
        </record>

        <record id="requerimiento_rule_borrado_propio" model="ir.rule">
            <field name="name">Requerimiento: borrado propio (solicitante)</field>
            <field name="model_id" ref="model_biocreto_requerimiento"/>
            <field name="groups" eval="[(4, ref('group_requerimiento_solicitante'))]"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[('solicitante_id', '=', user.id), ('state', 'in', ['borrador', 'cancelado'])]</field>
        </record>

        <!-- ── Encargado: todas ─────────────────────────────────────── -->
        <record id="requerimiento_rule_todas_encargado" model="ir.rule">
            <field name="name">Requerimiento: todas (encargado)</field>
            <field name="model_id" ref="model_biocreto_requerimiento"/>
            <field name="groups" eval="[(4, ref('group_requerimiento_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="0"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <record id="requerimiento_linea_rule_todas_encargado" model="ir.rule">
            <field name="name">Línea de requerimiento: todas (encargado)</field>
            <field name="model_id" ref="model_biocreto_requerimiento_linea"/>
            <field name="groups" eval="[(4, ref('group_requerimiento_user'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ── Administrador: todas, con borrado ────────────────────── -->
        <record id="requerimiento_rule_todas_manager" model="ir.rule">
            <field name="name">Requerimiento: todas (administrador)</field>
            <field name="model_id" ref="model_biocreto_requerimiento"/>
            <field name="groups" eval="[(4, ref('group_requerimiento_manager'))]"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[(1, '=', 1)]</field>
        </record>

        <!-- ── Multiempresa (globales, sin grupo) ───────────────────── -->
        <record id="requerimiento_rule_multicompany" model="ir.rule">
            <field name="name">biocreto_requerimiento multiempresa</field>
            <field name="model_id" ref="model_biocreto_requerimiento"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requerimiento_linea_rule_multicompany" model="ir.rule">
            <field name="name">biocreto_requerimiento_linea multiempresa</field>
            <field name="model_id" ref="model_biocreto_requerimiento_linea"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!-- ══ v19.0.1.2.0 — ENTREGAS DE MATERIAL ═════════════════════ -->

        <!-- Multiempresa (globales, sin grupo). -->
        <record id="requerimiento_entrega_rule_multicompany" model="ir.rule">
            <field name="name">biocreto_requerimiento_entrega multiempresa</field>
            <field name="model_id" ref="model_biocreto_requerimiento_entrega"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="requerimiento_entrega_linea_rule_multicompany" model="ir.rule">
            <field name="name">biocreto_requerimiento_entrega_linea multiempresa</field>
            <field name="model_id" ref="model_biocreto_requerimiento_entrega_linea"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!--
            Una entrega CONFIRMADA es inmutable: ya movió inventario y ya
            emitió constancia firmada.

            Se implementa como regla de perm_write/perm_unlink cuyo dominio
            solo deja pasar los borradores. Va SIN `groups`, o sea global:
            una regla con grupo se une por OR a las demás del mismo grupo y
            el administrador acabaría esquivándola. Global aplica a todos
            los usuarios salvo superusuario.

            El borrado tiene además su propio candado en Python
            (`_unlink_except_confirmada`), porque las reglas no cubren las
            escrituras hechas con sudo().
        -->
        <record id="requerimiento_entrega_rule_inmutable" model="ir.rule">
            <field name="name">Entrega: confirmada no se modifica</field>
            <field name="model_id" ref="model_biocreto_requerimiento_entrega"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[('state', '=', 'borrador')]</field>
        </record>

        <record id="requerimiento_entrega_linea_rule_inmutable" model="ir.rule">
            <field name="name">Línea de entrega: confirmada no se modifica</field>
            <field name="model_id" ref="model_biocreto_requerimiento_entrega_linea"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[('entrega_id.state', '=', 'borrador')]</field>
        </record>

        <!-- ══ v19.0.2.0.0 — INVENTARIO DE ACTIVOS ═══════════════════ -->
        <!-- Globales, sin `groups`: una regla con grupo se une por OR a
             las demas del mismo grupo y el administrador acabaria
             esquivandola. Mismo criterio que las de entrega. -->
        <record id="inventario_conteo_rule_multicompany" model="ir.rule">
            <field name="name">biocreto_inventario_conteo multiempresa</field>
            <field name="model_id" ref="model_biocreto_inventario_conteo"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <record id="inventario_conteo_linea_rule_multicompany" model="ir.rule">
            <field name="name">biocreto_inventario_conteo_linea multiempresa</field>
            <field name="model_id" ref="model_biocreto_inventario_conteo_linea"/>
            <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        </record>

        <!--
            Un conteo CERRADO es inmutable. Se implementa como regla de
            perm_write SIN `groups` —o sea global—, porque una regla con
            grupo se une por OR a las demas del mismo grupo y el
            administrador acabaria esquivandola. Mismo criterio que la de
            las entregas confirmadas.

            El candado de verdad esta en `BiocretoInventarioConteo.write`:
            las reglas de registro NO cubren las escrituras hechas con
            sudo(), y el flujo del propio modulo escribe `state` con los
            permisos del usuario. Por eso la regla deja pasar los cuatro
            estados y quien discrimina es el metodo; esta regla protege
            de escrituras genericas (importacion, acciones masivas).
        -->
        <record id="inventario_conteo_linea_rule_cerrado" model="ir.rule">
            <field name="name">Línea de conteo: cerrada no se modifica</field>
            <field name="model_id" ref="model_biocreto_inventario_conteo_linea"/>
            <field name="perm_read" eval="0"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
            <field name="domain_force">[('state', 'not in', ('enviado', 'validado'))]</field>
        </record>

        <!-- Categoría compartida: company_id vacío la hace visible desde
             todas las plantas. -->
        <record id="requerimiento_categoria_rule_multicompany" model="ir.rule">
            <field name="name">biocreto_requerimiento_categoria multiempresa</field>
            <field name="model_id" ref="model_biocreto_requerimiento_categoria"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>
