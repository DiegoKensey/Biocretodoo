<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Banner verde post-firma: texto custom cuando la orden quedó en 'contract'. -->
    <template id="sale_order_portal_template_inherit_contract"
              inherit_id="sale.sale_order_portal_template"
              name="BIOCRETO Contract Sign Banner">
        <xpath expr="//div[@t-if=&quot;message == 'sign_ok'&quot;]" position="replace">
            <div t-if="message == 'sign_ok'"
                 class="alert alert-success alert-dismissible d-print-none"
                 role="status">
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                <t t-if="sale_order.state == 'contract'">
                    <strong>¡Gracias! Hemos recibido su firma.</strong>
                    <br/>
                    <span>Su asesor comercial le enviará el contrato pronto.</span>
                </t>
                <t t-else="">
                    <strong>Thank You!</strong>
                    <br/>
                    <t t-if="sale_order.state == 'sale'">
                        Your order has been confirmed.
                    </t>
                    <t t-elif="sale_order._has_to_be_paid()">
                        Your order has been signed but still needs to be paid to be confirmed.
                    </t>
                    <t t-else="">Your order has been signed.</t>
                </t>
            </div>
        </xpath>
    </template>

    <!-- Breadcrumb: ruta padre dinámica para órdenes en estado 'contract'. -->
    <template id="portal_my_home_menu_sale_inherit_contract"
              inherit_id="sale.portal_my_home_menu_sale"
              name="BIOCRETO Contract Breadcrumb">
        <!-- Excluir 'contract' del t-elif nativo que apunta a /my/orders. -->
        <xpath expr="//li[@id='portal_breadcrumbs_sale']" position="after">
            <li t-if="page_name == 'contract' or sale_order and sale_order.state == 'contract'"
                t-attf-class="breadcrumb-item #{'active ' if not sale_order else ''}">
                <a t-if="sale_order" t-attf-href="/my/contracts?{{ keep_query() }}">Contratos</a>
                <t t-else="">Contratos</t>
            </li>
        </xpath>
        <xpath expr="//li[contains(@t-elif, 'page_name == ')]" position="attributes">
            <attribute name="t-elif">page_name == 'order' or sale_order and sale_order.state not in ('sent', 'cancel', 'contract')</attribute>
        </xpath>
    </template>

    <!-- Menú lateral del portal: nueva entrada "Contratos". -->
    <template id="portal_my_home_sale_inherit_contract"
              inherit_id="sale.portal_my_home_sale"
              name="BIOCRETO Contracts Menu Entry">
        <xpath expr="//div[@id='portal_client_category']" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Contratos</t>
                <t t-set="url" t-value="'/my/contracts'"/>
                <t t-set="text">Sus cotizaciones firmadas pendientes de contrato</t>
                <t t-set="placeholder_count" t-value="'contract_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Bloque "Customer Information" del portal: divide la dirección única
         de facturación-y-envío del nativo en DOS apartados:
           A) Dirección de facturación: datos del partner (igual que el nativo,
              widget contact con name/address/phone/email del partner_invoice_id).
           B) Dirección de envío: dirección de la OBRA (campos estructurados
              de biocreto_sale_extension), apilada. Se OCULTA si la cotización
              no tiene ningún campo BIOCRETO de dirección.
         El partner_shipping_id nativo se ignora — en BIOCRETO la "dirección de
         envío" es la ubicación de la obra, no el shipping address del partner. -->
    <template id="portal_order_address_split_biocreto"
              inherit_id="sale.sale_order_portal_content"
              name="BIOCRETO Split Billing/Shipping Address">
        <xpath expr="//div[@id='customer_info']" position="replace">
            <div id="customer_info" class="col-12 col-lg-6 mb-4">

                <!-- ──── Bloque A: Dirección de facturación ──── -->
                <h5 class="mb-1">
                    Dirección de facturación
                    <small t-if="sale_order.partner_id == sale_order.partner_invoice_id == sale_order.env.user.partner_id">
                        <a class="small" t-attf-href="/my/account?redirect={{sale_order.get_portal_url()}}">
                            <i class="fa fa-fw fa-pencil"/>
                        </a>
                    </small>
                </h5>
                <hr class="mt-1 mb-2"/>
                <div t-field="sale_order.partner_invoice_id"
                     t-options="{'widget': 'contact', 'fields': ['name', 'address', 'phone', 'email']}"/>

                <!-- ──── Bloque B: Dirección de envío (obra) ──── -->
                <t t-if="sale_order.biocreto_street or sale_order.biocreto_district_id or sale_order.biocreto_city_id or sale_order.biocreto_state_id">
                    <br/>
                    <h5 class="mb-1">Dirección de envío</h5>
                    <hr class="mt-1 mb-2"/>
                    <div class="d-flex align-items-baseline gap-1">
                        <i class="fa fa-map-marker fa-fw" role="img"
                           aria-label="Dirección" title="Dirección"/>
                        <span class="w-100 lh-sm text-break d-block" itemprop="streetAddress">
                            <t t-if="sale_order.biocreto_street">
                                <span t-field="sale_order.biocreto_street"/><br/>
                            </t>
                            <t t-if="sale_order.biocreto_district_id">
                                <span t-field="sale_order.biocreto_district_id.name"/><br/>
                            </t>
                            <t t-if="sale_order.biocreto_city_id">
                                <span t-field="sale_order.biocreto_city_id.name"/><br/>
                            </t>
                            <t t-if="sale_order.biocreto_state_id">
                                <span t-field="sale_order.biocreto_state_id.name"/><br/>
                            </t>
                            Perú
                        </span>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <!--
        v19.0.1.2.0: bloque "Contrato de Suministro" en /my/orders/<id>
        cuando la orden esta en contract/programado/sale.

        Diseno:
        - SIN override del controller portal_order_page (es complejo y se
          acopla al nativo). En su lugar, calculamos los 2 flags aqui mismo:
            * biocreto_es_contrato  = sale_order.state in ('contract','programado','sale')
            * biocreto_sign_kind    = request.params.get('sign')  (cliente / jefe_obra / ambos)
          `request` es global en QWeb portal (verificado contra el uso del
          mismo objeto en sale_portal_templates.xml:313 para csrf_token).
        - Tres botones que recargan la pagina con ?sign=... Asi solo se
          renderiza UN widget de firma a la vez, evitando colision de IDs
          del componente OWL SignatureForm.
        - Boton "Descargar Contrato (PDF)" apunta a la ruta nueva
          /my/contracts/<id>/pdf con access_token (PlutoPrint automatico).
        - Estado de firmas: muestra "firmado por X el Y" para cada uno
          si existe el campo de fecha (criterio: la fecha es el flag mas
          honesto — solo se setea junto a la firma binaria).
        - Tras firmar -> el controller redirige con &message=contract_signed
          que un t-if al inicio convierte en un alert verde.
    -->
    <template id="sale_order_portal_content_contract_block"
              inherit_id="sale.sale_order_portal_content"
              name="BIOCRETO Contract Block">
        <xpath expr="//div[@id='introduction']" position="before">
            <t t-set="biocreto_es_contrato"
               t-value="sale_order.state in ('contract', 'programado', 'sale')"/>
            <t t-if="biocreto_es_contrato">
                <t t-set="biocreto_sign_kind" t-value="request.params.get('sign')"/>
                <t t-set="biocreto_msg" t-value="request.params.get('message')"/>

                <!-- Alert de exito post-firma -->
                <div t-if="biocreto_msg == 'contract_signed'"
                     class="alert alert-success alert-dismissible d-print-none"
                     role="status">
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"/>
                    <strong>¡Gracias! Hemos recibido su firma del contrato.</strong>
                </div>

                <!-- Encabezado + descarga PDF -->
                <div class="card mb-3">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
                            <h4 class="mb-0">Contrato de Suministro</h4>
                            <a class="btn btn-primary"
                               t-attf-href="/my/contracts/#{sale_order.id}/pdf?access_token=#{sale_order.access_token}"
                               target="_blank">
                                <i class="fa fa-download me-1"/>Descargar Contrato (PDF)
                            </a>
                        </div>

                        <!-- Estado de firmas -->
                        <ul class="list-unstyled mb-3">
                            <li class="mb-1">
                                <strong>Cliente:</strong>
                                <t t-if="sale_order.biocreto_firma_contrato_fecha">
                                    <span class="text-success">
                                        <i class="fa fa-check-circle me-1"/>firmado por
                                        <span t-out="sale_order.biocreto_firma_contrato_por or '—'"/> el
                                        <span t-field="sale_order.biocreto_firma_contrato_fecha"
                                              t-options="{'widget': 'datetime'}"/>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">pendiente</span>
                                </t>
                            </li>
                            <li>
                                <strong>Jefe de Obra:</strong>
                                <t t-if="sale_order.biocreto_firma_jefe_obra_fecha">
                                    <span class="text-success">
                                        <i class="fa fa-check-circle me-1"/>firmado por
                                        <span t-out="sale_order.biocreto_firma_jefe_obra_por or '—'"/> el
                                        <span t-field="sale_order.biocreto_firma_jefe_obra_fecha"
                                              t-options="{'widget': 'datetime'}"/>
                                    </span>
                                </t>
                                <t t-else="">
                                    <span class="text-muted">pendiente</span>
                                </t>
                            </li>
                        </ul>

                        <!-- 3 botones de firma: solo si no hay widget activo -->
                        <div t-if="not biocreto_sign_kind"
                             class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-primary"
                               t-attf-href="/my/orders/#{sale_order.id}?access_token=#{sale_order.access_token}&amp;sign=cliente">
                                Firmar como Cliente
                            </a>
                            <a class="btn btn-outline-primary"
                               t-attf-href="/my/orders/#{sale_order.id}?access_token=#{sale_order.access_token}&amp;sign=jefe_obra">
                                Firmar como Jefe de Obra
                            </a>
                            <a class="btn btn-outline-primary"
                               t-attf-href="/my/orders/#{sale_order.id}?access_token=#{sale_order.access_token}&amp;sign=ambos">
                                Firmar Ambos
                            </a>
                        </div>

                        <!-- Widget de firma ACTIVO: uno solo segun biocreto_sign_kind -->
                        <div t-if="biocreto_sign_kind in ('cliente', 'jefe_obra', 'ambos')"
                             class="mt-3 border-top pt-3">
                            <h5 t-if="biocreto_sign_kind == 'cliente'">Firma del Cliente</h5>
                            <h5 t-if="biocreto_sign_kind == 'jefe_obra'">Firma del Jefe de Obra</h5>
                            <h5 t-if="biocreto_sign_kind == 'ambos'">Firma (Cliente y Jefe de Obra)</h5>

                            <t t-call="portal.signature_form">
                                <t t-set="call_url"
                                   t-value="sale_order.get_portal_url(suffix='/sign_contract/' + biocreto_sign_kind)"/>
                                <t t-set="default_name"
                                   t-value="(sale_order.partner_id.name or sale_order.partner_id.commercial_partner_id.name) if biocreto_sign_kind in ('cliente', 'ambos') else ''"/>
                            </t>

                            <a class="btn btn-link mt-2"
                               t-attf-href="/my/orders/#{sale_order.id}?access_token=#{sale_order.access_token}">
                                Cancelar
                            </a>
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>

    <!-- Página /my/contracts: listado de órdenes en estado 'contract' del cliente. -->
    <template id="portal_my_contracts" name="BIOCRETO My Contracts">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Contratos</t>
            </t>

            <div t-if="not contracts" class="alert alert-warning" role="alert">
                No hay contratos pendientes en su cuenta.
            </div>

            <t t-if="contracts" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>
                            <span class="d-none d-md-inline">Contrato N°</span>
                            <span class="d-block d-md-none">Ref.</span>
                        </th>
                        <th class="text-end">Fecha</th>
                        <th class="text-center">Estado</th>
                        <th class="text-end">Total</th>
                    </tr>
                </thead>
                <t t-foreach="contracts" t-as="contract">
                    <tr>
                        <td>
                            <a t-att-href="contract.get_portal_url()">
                                <t t-out="contract.name"/>
                            </a>
                        </td>
                        <td class="text-end">
                            <span t-field="contract.date_order" t-options="{'widget': 'date'}"/>
                        </td>
                        <td class="text-center">
                            <span class="badge rounded-pill text-bg-success">Contrato</span>
                        </td>
                        <td class="text-end">
                            <span t-field="contract.amount_total"/>
                        </td>
                    </tr>
                </t>
            </t>
        </t>
    </template>

</odoo>
