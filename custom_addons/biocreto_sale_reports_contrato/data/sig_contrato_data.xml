<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Registro SIG para el Contrato de Suministro (BC-GC-FR-05).
            noupdate=1 para que las actualizaciones del modulo no
            sobrescriban los ajustes que el cliente pueda hacer sobre
            la version vigente (cambio de version, fecha, etc.).
            La plantilla QWeb consulta este registro via
            biocreto.documento.control.get_control_for_qweb('contrato').
        -->
        <record id="sig_contrato" model="biocreto.documento.control">
            <field name="name">Contrato de Suministro de Concreto</field>
            <field name="codigo">BC-GC-FR-05</field>
            <field name="codigo_documento">contrato</field>
            <field name="version">04</field>
            <field name="fecha_version" eval="'2025-11-25'"/>
            <field name="descripcion">Formato del contrato de suministro de concreto premezclado entre BIOCRETO y el CLIENTE. Incluye clausulas comerciales, checklist de requerimientos, procedimiento de vaciado y condiciones de aceptacion/curado.</field>
        </record>
    </data>
</odoo>
