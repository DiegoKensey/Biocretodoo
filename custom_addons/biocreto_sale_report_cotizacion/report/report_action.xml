<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ============================================================
        ir.actions.report  -  Cotizacion BIOCRETO (router menor/mayor)
        ============================================================
        Un solo report_action. La plantilla report_cotizacion enruta
        internamente al body menor o mayor segun
        o.biocreto_tipo_proyecto ('menor' / 'mayor', valores literales
        confirmados en
        custom_addons/biocreto_sale_extension/models/sale_order.py:72-79).

        print_report_name usa 'Cotizacion' + o.name para que el PDF
        descargado se llame, p.ej., "Cotizacion 2025-CFC-DO-0042.pdf".
    -->
    <record id="action_report_cotizacion_biocreto" model="ir.actions.report">
        <field name="name">Cotizacion BIOCRETO</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">biocreto_sale_report_cotizacion.report_cotizacion</field>
        <field name="report_file">biocreto_sale_report_cotizacion.report_cotizacion</field>
        <field name="paperformat_id" ref="paperformat_biocreto_cot_a4"/>
        <field name="print_report_name">'Cotizacion %s' % (object.name or '').replace('/', '_')</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
    </record>

    <!--
        ============================================================
        Quitar el reporte nativo de venta del menu Imprimir
        ============================================================
        sale.action_report_saleorder es el xml id del reporte nativo
        (verificado en addons/sale/controllers/portal.py:144,330).
        Se le anula binding_model_id para que NO aparezca en el
        dropdown del boton Imprimir. El registro de la accion sigue
        existiendo y se puede invocar via codigo / portal / shell;
        simplemente no estorba al usuario final.
        NO se desinstala el modulo sale ni se borra la accion.
    -->
    <record id="sale.action_report_saleorder" model="ir.actions.report">
        <field name="binding_model_id" eval="False"/>
    </record>

</odoo>
