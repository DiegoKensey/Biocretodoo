<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_quotation_biocreto">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page biocreto-coti-doc"
                     lang="es-PE"
                     style="background:#FFFFFF; color:#2C2C2A;
                            font-family: 'DejaVu Sans', Helvetica, Arial, sans-serif;
                            font-size:12px; padding:0;
                            -webkit-font-smoothing: antialiased;">

                    <!-- ============ ESTILOS INLINE ============ -->
                    <style>
                        @charset "UTF-8";
                        .biocreto-coti-doc { color: #2C2C2A; }
                        .coti-top { display: table; width: 100%; margin-bottom: 14px; }
                        .coti-top-cell { display: table-cell; vertical-align: middle; }
                        .coti-top-left { width: 25%; }
                        .coti-top-center { width: 50%; text-align: center; }
                        .coti-top-right { width: 25%; text-align: right; font-size: 11px; color: #5F5E5A; line-height: 1.7; }
                        .coti-top-right strong { color: #185FA5; font-weight: bold; }
                        .coti-title { font-size: 14px; color: #185FA5; letter-spacing: 1.2px; font-weight: bold; }
                        .coti-loc { font-size: 11px; color: #5F5E5A; margin-top: 4px; }
                        .coti-num-block { text-align: right; margin: 8px 0 14px; padding-bottom: 12px; border-bottom: 1px solid #E5E5E5; }
                        .coti-num-lbl { font-size: 9px; color: #888780; letter-spacing: 1.2px; text-transform: uppercase; margin-bottom: 2px; }
                        .coti-num-val { font-size: 22px; color: #185FA5; font-weight: bold; letter-spacing: 1px; font-family: 'Courier New', Courier, monospace; }
                        .salute { background: #F4F7FB; padding: 14px 16px; margin-bottom: 16px; border: 1px solid #E5E5E5; border-radius: 6px; page-break-inside: avoid; }
                        .salute-table { width: 100%; }
                        .salute-table td { padding: 4px 12px 4px 0; vertical-align: top; }
                        .field-k { font-size: 10px; color: #185FA5; letter-spacing: 0.6px; text-transform: uppercase; font-weight: bold; }
                        .field-v { font-size: 12px; color: #2C2C2A; font-weight: bold; }
                        .section-bar { background: #185FA5; padding: 7px 14px; font-size: 11px; color: white; letter-spacing: 0.6px; font-weight: bold; margin-top: 18px; page-break-after: avoid; }
                        .section-desc { font-size: 11px; color: #5F5E5A; font-style: italic; padding: 8px 14px 10px; background: #F4F7FB; page-break-after: avoid; }
                        .coti-table { width: 100%; border-collapse: collapse; font-size: 11px; page-break-inside: avoid; }
                        .coti-table thead { display: table-header-group; }
                        .coti-table thead th { background: #185FA5; color: white; padding: 7px 6px; text-align: left; font-weight: bold; font-size: 9px; letter-spacing: 0.4px; }
                        .coti-table thead th.r { text-align: right; }
                        .coti-table tbody td { padding: 7px 6px; color: #2C2C2A; border-bottom: 1px solid #E5E5E5; font-size: 10px; }
                        .coti-table tbody td.r { text-align: right; }
                        .coti-table tr { page-break-inside: avoid; }
                        .subtotal-row td { background: #F4F7FB; font-weight: bold; }
                        .igv-row td { color: #5F5E5A; }
                        .total-row td { background: #185FA5; color: white; font-weight: bold; font-size: 11px; }
                        .bombeo-banner { background: #F4F7FB; padding: 12px 16px; margin-top: 14px; border: 1px solid #E5E5E5; border-radius: 6px; page-break-inside: avoid; }
                        .badge-incluido { background: #C0DD97; color: #173404; font-size: 10px; padding: 4px 12px; font-weight: bold; letter-spacing: 0.8px; border-radius: 4px; }
                        .badge-no-incluido { background: #F2C0C0; color: #5C0E0E; font-size: 10px; padding: 4px 12px; font-weight: bold; letter-spacing: 0.8px; border-radius: 4px; }
                        .total-banner { margin-top: 16px; background: #185FA5; padding: 12px 16px; color: white; font-weight: bold; page-break-inside: avoid; }
                        .info-grid { display: table; width: 100%; border-collapse: separate; border-spacing: 6px 0; table-layout: fixed; margin-top: 14px; }
                        .info-grid-row { display: table-row; page-break-inside: avoid; }
                        .info-grid-cell { display: table-cell; width: 50%; vertical-align: top; padding: 0; }
                        .info-grid-cell-full { display: table-cell; width: 100%; vertical-align: top; padding: 0; }
                        .info-card { background: #F4F7FB; padding: 12px 14px; border: 1px solid #E5E5E5; border-radius: 6px; page-break-inside: avoid; margin-bottom: 6px; height: auto; }
                        .info-card-title { font-size: 10px; color: #185FA5; letter-spacing: 0.6px; text-transform: uppercase; font-weight: bold; margin-bottom: 8px; padding-bottom: 6px; border-bottom: 1px solid #D5DDE8; }
                        .info-list { list-style: none; padding: 0; margin: 0; font-size: 11px; color: #444441; }
                        .info-list li { padding: 4px 0 4px 14px; position: relative; line-height: 1.5; }
                        .info-list li:before { content: "\25B8"; position: absolute; left: 0; color: #185FA5; font-size: 9px; }
                        .info-list li strong { color: #2C2C2A; font-weight: bold; }
                        .checked-list { list-style: none; padding: 0; margin: 0; font-size: 11px; color: #444441; }
                        .checked-list li { padding: 4px 0 4px 18px; position: relative; line-height: 1.5; }
                        .checked-list li:before { content: "\2713"; position: absolute; left: 0; color: #639922; font-weight: bold; }
                        .yellow-band { margin-top: 18px; padding: 12px 16px; background: #FAEEDA; border-left: 3px solid #F5C84B; font-size: 11px; color: #2C2C2A; line-height: 1.6; page-break-inside: avoid; }
                        .signatures { margin-top: 24px; padding-top: 14px; border-top: 1px solid #E5E5E5; page-break-inside: avoid; }
                        .signatures-table { width: 100%; }
                        .signatures-table td { width: 50%; text-align: center; vertical-align: top; padding: 0 15px; }
                        .signature-img { max-width: 200px; max-height: 80px; }
                        .signature-line { border-top: 1px solid #888780; margin-top: 32px; padding-top: 6px; font-size: 10px; color: #5F5E5A; }
                        .signature-name { color: #2C2C2A; font-weight: bold; font-size: 11px; }
                    </style>

                    <!-- ============ CABECERA ============ -->
                    <div class="coti-top">
                        <div class="coti-top-cell coti-top-left">
                            <img t-if="o.company_id.logo"
                                 t-att-src="image_data_uri(o.company_id.logo)"
                                 style="max-width: 180px; max-height: 70px;"/>
                        </div>
                        <div class="coti-top-cell coti-top-center">
                            <div class="coti-title">COTIZACION DE CONCRETO PREMEZCLADO</div>
                            <div class="coti-loc">Huancayo, Junín &#183; Perú</div>
                        </div>
                        <div class="coti-top-cell coti-top-right">
                            <div t-if="o.biocreto_tipo_proyecto == 'menor'">
                                <strong>Código:</strong> BC-GC-FR-09
                            </div>
                            <div t-elif="o.biocreto_tipo_proyecto == 'mayor'">
                                <strong>Código:</strong> BC-GC-FR-10
                            </div>
                            <div><strong>Versión:</strong> 01</div>
                            <div>
                                <strong>Fecha:</strong>
                                <span t-out="o.date_order.strftime('%d/%m/%Y') if o.date_order else ''"/>
                            </div>
                        </div>
                    </div>

                    <!-- ============ N° COTIZACIÓN ============ -->
                    <div class="coti-num-block">
                        <div class="coti-num-lbl">N&#176; Cotización</div>
                        <div class="coti-num-val">
                            <span t-field="o.name"/>
                        </div>
                    </div>

                    <!-- ============ DATOS DEL CLIENTE / OBRA ============ -->
                    <div class="salute">
                        <table class="salute-table" t-if="o.biocreto_tipo_proyecto == 'mayor'">
                            <tr>
                                <td>
                                    <div class="field-k">Razón social</div>
                                    <div class="field-v"><span t-field="o.partner_id.name"/></div>
                                </td>
                                <td>
                                    <div class="field-k">RUC</div>
                                    <div class="field-v"><span t-field="o.partner_id.vat"/></div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="field-k">Obra</div>
                                    <div class="field-v"><span t-field="o.biocreto_obra"/></div>
                                </td>
                                <td>
                                    <div class="field-k">Dirección de obra</div>
                                    <div class="field-v"><span t-field="o.biocreto_direccion_obra"/></div>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <div class="field-k">Atención</div>
                                    <div class="field-v">
                                        <span t-out="o.partner_id.child_ids[:1].name if o.partner_id.child_ids else o.partner_id.name"/>
                                    </div>
                                </td>
                                <td>
                                    <div class="field-k">Teléfono</div>
                                    <div class="field-v"><span t-field="o.partner_id.phone"/></div>
                                </td>
                            </tr>
                        </table>

                        <table class="salute-table" t-elif="o.biocreto_tipo_proyecto == 'menor'">
                            <tr>
                                <td>
                                    <div class="field-k">Nombre del cliente</div>
                                    <div class="field-v"><span t-field="o.partner_id.name"/></div>
                                </td>
                                <td>
                                    <div class="field-k">DNI</div>
                                    <div class="field-v"><span t-field="o.partner_id.vat"/></div>
                                </td>
                                <td>
                                    <div class="field-k">N&#176; de celular</div>
                                    <div class="field-v"><span t-field="o.partner_id.phone"/></div>
                                </td>
                            </tr>
                            <tr>
                                <td colspan="2">
                                    <div class="field-k">Dirección de obra</div>
                                    <div class="field-v"><span t-field="o.biocreto_direccion_obra"/></div>
                                </td>
                                <td>
                                    <div class="field-k">Obra</div>
                                    <div class="field-v"><span t-field="o.biocreto_obra"/></div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ============ SECCIÓN A: SUMINISTRO DE CONCRETO ============ -->
                    <div class="section-bar">A. SUMINISTRO DE CONCRETO PREMEZCLADO</div>
                    <div class="section-desc">
                        Preparación del concreto con los más altos estándares de calidad y transporte en camiones mixer a obra.
                    </div>

                    <table class="coti-table">
                        <thead>
                            <tr>
                                <th style="width:5%">ITEM</th>
                                <th style="width:22%">ESTRUCTURA</th>
                                <th style="width:9%">F'C KG/CM&#178;</th>
                                <th style="width:13%">TIPO CEMENTO</th>
                                <th style="width:7%">HUSO TMN</th>
                                <th style="width:8%">SLUMP</th>
                                <th style="width:9%" class="r">VOLUMEN M&#179;</th>
                                <th style="width:12%" class="r">P. UNIT. S/</th>
                                <th style="width:15%" class="r">TOTAL S/</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="concreto_lines" t-value="o._biocreto_get_concreto_lines()"/>
                            <t t-foreach="concreto_lines" t-as="line">
                                <tr>
                                    <td><span t-out="line_index + 1"/></td>
                                    <td><span t-field="o.biocreto_estructura"/></td>
                                    <td><span t-field="o.biocreto_fc"/></td>
                                    <td>
                                        <t t-if="o.biocreto_tipo_cemento == 'i_premium'">I - Andino Premium</t>
                                        <t t-elif="o.biocreto_tipo_cemento == 'ii_forte'">II - Andino Forte</t>
                                        <t t-elif="o.biocreto_tipo_cemento == 'v_hs'">V - Andino HS</t>
                                        <t t-elif="o.biocreto_tipo_cemento == 'v_ultra'">V - Andino Ultra</t>
                                    </td>
                                    <td>
                                        <t t-if="o.biocreto_huso_tmn == '1_2'">1/2"</t>
                                        <t t-elif="o.biocreto_huso_tmn == '3_4'">3/4"</t>
                                        <t t-elif="o.biocreto_huso_tmn == '1'">1"</t>
                                    </td>
                                    <td><span t-field="o.biocreto_slump"/></td>
                                    <td class="r">
                                        <span t-out="'%.2f' % line.product_uom_qty"/>
                                    </td>
                                    <td class="r">
                                        <span t-out="'%.2f' % line.price_unit"/>
                                    </td>
                                    <td class="r">
                                        <span t-out="'%.2f' % line.price_subtotal"/>
                                    </td>
                                </tr>
                            </t>
                            <tr class="subtotal-row">
                                <td colspan="5"></td>
                                <td class="r">Total m&#179;</td>
                                <td class="r">
                                    <span t-out="'%.2f' % o._biocreto_get_concreto_total_volume()"/>
                                </td>
                                <td class="r">Subtotal S/</td>
                                <td class="r">
                                    <span t-out="'%.2f' % o._biocreto_get_concreto_subtotal()"/>
                                </td>
                            </tr>
                            <tr class="igv-row">
                                <td colspan="7"></td>
                                <td class="r">IGV (18%) S/</td>
                                <td class="r">
                                    <span t-out="'%.2f' % (o._biocreto_get_concreto_subtotal() * 0.18)"/>
                                </td>
                            </tr>
                            <tr class="total-row">
                                <td colspan="7"></td>
                                <td class="r">(A) Total S/</td>
                                <td class="r">
                                    <span t-out="'%.2f' % (o._biocreto_get_concreto_subtotal() * 1.18)"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- ============ BANNER DE BOMBEO ============ -->
                    <div class="bombeo-banner">
                        <table style="width:100%">
                            <tr>
                                <td style="vertical-align:middle;">
                                    <span style="font-size:12px; color:#2C2C2A; font-weight:bold;">
                                        Servicio de bombeo
                                    </span>
                                </td>
                                <td style="text-align:right; vertical-align:middle;">
                                    <span t-if="o.biocreto_bombeo_required" class="badge-incluido">
                                        INCLUIDO
                                    </span>
                                    <span t-else="" class="badge-no-incluido">
                                        NO INCLUIDO
                                    </span>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ============ SECCIÓN B: BOMBEO (sólo si required) ============ -->
                    <t t-if="o.biocreto_bombeo_required">
                        <div class="section-bar">B. SERVICIO DE BOMBEO</div>
                        <div class="section-desc">
                            Autobomba &#8212; transporte del concreto por tuberías de alta presión desde el mixer al punto de vaciado.
                        </div>

                        <table class="coti-table">
                            <thead>
                                <tr>
                                    <th style="width:5%">ITEM</th>
                                    <th style="width:26%">TIPO DE BOMBA</th>
                                    <th style="width:17%">TUBERÍAS ADIC.</th>
                                    <th style="width:13%">SLUMP BOMB.</th>
                                    <th style="width:10%" class="r">VOLUMEN M&#179;</th>
                                    <th style="width:13%" class="r">P. UNIT. S/</th>
                                    <th style="width:16%" class="r">TOTAL S/</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="bombeo_lines" t-value="o._biocreto_get_bombeo_lines()"/>
                                <t t-foreach="bombeo_lines" t-as="bline">
                                    <tr>
                                        <td><span t-out="bline_index + 1"/></td>
                                        <td><span t-field="bline.product_id.name"/></td>
                                        <td>
                                            <t t-if="o.biocreto_tuberia_adicional">
                                                <span t-out="o.biocreto_tuberia_adicional"/> m
                                            </t>
                                            <t t-else="">&#8212;</t>
                                        </td>
                                        <td><span t-field="o.biocreto_slump_bombeable"/></td>
                                        <td class="r">
                                            <span t-out="'%.2f' % bline.product_uom_qty"/>
                                        </td>
                                        <td class="r">
                                            <span t-out="'%.2f' % bline.price_unit"/>
                                        </td>
                                        <td class="r">
                                            <span t-out="'%.2f' % bline.price_subtotal"/>
                                        </td>
                                    </tr>
                                </t>
                                <tr class="subtotal-row">
                                    <td colspan="3"></td>
                                    <td class="r">Total m&#179;</td>
                                    <td class="r">
                                        <span t-out="'%.2f' % sum(bombeo_lines.mapped('product_uom_qty'))"/>
                                    </td>
                                    <td class="r">Subtotal S/</td>
                                    <td class="r">
                                        <span t-out="'%.2f' % o._biocreto_get_bombeo_subtotal()"/>
                                    </td>
                                </tr>
                                <tr class="igv-row">
                                    <td colspan="5"></td>
                                    <td class="r">IGV (18%) S/</td>
                                    <td class="r">
                                        <span t-out="'%.2f' % (o._biocreto_get_bombeo_subtotal() * 0.18)"/>
                                    </td>
                                </tr>
                                <tr class="total-row">
                                    <td colspan="5"></td>
                                    <td class="r">(B) Total S/</td>
                                    <td class="r">
                                        <span t-out="'%.2f' % (o._biocreto_get_bombeo_subtotal() * 1.18)"/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </t>

                    <!-- ============ TOTAL GENERAL ============ -->
                    <div class="total-banner">
                        <table style="width:100%">
                            <tr>
                                <td style="font-size:12px; letter-spacing:0.6px;">
                                    <t t-if="o.biocreto_bombeo_required">
                                        TOTAL COTIZACIÓN (A + B)
                                    </t>
                                    <t t-else="">
                                        TOTAL COTIZACIÓN (A)
                                    </t>
                                </td>
                                <td style="text-align:right; font-size:16px;">
                                    S/ <span t-out="'%.2f' % o.amount_total"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- ============ BLOQUES INFERIORES POR TIPO ============ -->

                    <t t-if="o.biocreto_tipo_proyecto == 'mayor'">
                        <div class="info-grid">
                            <div class="info-grid-row">
                                <div class="info-grid-cell">
                                    <div class="info-card">
                                        <div class="info-card-title">Términos y condiciones</div>
                                        <ul class="info-list">
                                            <li><strong>Moneda y pago:</strong> Soles (S/) &#8212; 50% anticipo y saldo contra entrega</li>
                                            <li><strong>Anticipación:</strong> 72 horas con pre-programación semanal</li>
                                            <li><strong>Flete adicional:</strong> Atenciones &#8804; 5 m&#179; con cargo extra por viaje</li>
                                            <li><strong>Disponibilidad:</strong> Lunes a sábado &#183; Nocturno y feriados con recargo</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="info-grid-cell">
                                    <div class="info-card">
                                        <div class="info-card-title">Cuentas bancarias &#183; Soles</div>
                                        <t t-if="o.company_id.bank_ids">
                                            <t t-foreach="o.company_id.bank_ids" t-as="bank">
                                                <div style="padding: 6px 0; border-bottom: 1px dotted #D5DDE8;">
                                                    <div style="font-size:11px; color:#2C2C2A; font-weight:bold;">
                                                        <span t-field="bank.bank_id.name"/> &#8212; Cta. corriente
                                                    </div>
                                                    <div style="font-size:10px; color:#5F5E5A; font-family:'Courier New',monospace;">
                                                        <span t-field="bank.acc_number"/>
                                                    </div>
                                                </div>
                                            </t>
                                        </t>
                                        <t t-else="">
                                            <div style="font-size:10px; color:#5F5E5A; font-style:italic;">
                                                Sin cuentas bancarias configuradas.
                                            </div>
                                        </t>
                                    </div>
                                </div>
                            </div>

                            <div class="info-grid-row">
                                <div class="info-grid-cell">
                                    <div class="info-card">
                                        <div class="info-card-title">Especificaciones técnicas</div>
                                        <ul class="info-list">
                                            <li><strong>Cemento:</strong> Portland ASTM C-150 Tipo I &#8212; Andino</li>
                                            <li><strong>Agua:</strong> Cumple ASTM C-1602 para concreto</li>
                                            <li><strong>Arena gruesa:</strong> Río Mantaro (Matahuasi) y cantera Orcotuna</li>
                                            <li><strong>Piedra chancada:</strong> Río Mantaro, Matahuasi</li>
                                            <li><strong>Aditivos:</strong> Fluxcrete 1000, Fluxcrete 31RF, Plastcon RF20</li>
                                            <li><strong>Norma:</strong> NTP 339.114 y RNE 0.60 Concreto Armado</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="info-grid-cell">
                                    <div class="info-card">
                                        <div class="info-card-title">Capacidad operativa</div>
                                        <ul class="info-list">
                                            <li>03 plantas semiautomatizadas &#8212; Cajas, Concepción, Comuneros</li>
                                            <li>03 plantas móviles para obra</li>
                                            <li>12 camiones mixer de concreto</li>
                                            <li>03 bombas telescópicas &#8212; 32 m, 38 m, 47 m</li>
                                            <li>02 volquetes &#183; 03 cargadores frontales &#183; 01 retroexcavadora</li>
                                            <li>50 m&#179;/hora de capacidad (sede Cajas)</li>
                                            <li>Laboratorio equipado &#183; Staff técnico especializado</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="info-grid-row">
                                <div class="info-grid-cell">
                                    <div class="info-card">
                                        <div class="info-card-title">Servicios incluidos</div>
                                        <ul class="checked-list">
                                            <li>Máquina vibradora para compactado (opcional)</li>
                                            <li>Probetas NTP 339.114 &#8212; 3 testigos cada 40 m&#179;</li>
                                            <li>Prueba de SLUMP en obra</li>
                                            <li>Rotura a 28 días + certificación de probetas</li>
                                            <li>Asesoría técnica en obra</li>
                                        </ul>
                                    </div>
                                </div>
                                <div class="info-grid-cell">
                                    <div class="info-card">
                                        <div class="info-card-title">Información complementaria</div>
                                        <ul class="info-list">
                                            <li><strong>Tiempo de espera en obra:</strong> 10 a 20 minutos</li>
                                            <li><strong>Volumen mínimo de suministro:</strong> 5 m&#179;</li>
                                            <li><strong>Vigencia de la cotización:</strong> 10 días calendario</li>
