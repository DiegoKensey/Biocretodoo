<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ============ HUMEDAD ============ -->
    <record id="view_biocreto_lab_humedad_list" model="ir.ui.view">
        <field name="name">biocreto.lab.humedad.list</field>
        <field name="model">biocreto.lab.humedad</field>
        <field name="arch" type="xml">
            <list string="Humedades">
                <field name="fecha"/>
                <field name="tipo_agregado"/>
                <field name="humedad"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_biocreto_lab_humedad_form" model="ir.ui.view">
        <field name="name">biocreto.lab.humedad.form</field>
        <field name="model">biocreto.lab.humedad</field>
        <field name="arch" type="xml">
            <form string="Humedad">
                <sheet>
                    <group>
                        <group>
                            <field name="fecha"/>
                            <field name="tipo_agregado"/>
                            <field name="humedad"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Observaciones">
                        <field name="observaciones" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_biocreto_lab_humedad" model="ir.actions.act_window">
        <field name="name">Humedades</field>
        <field name="res_model">biocreto.lab.humedad</field>
        <field name="view_mode">list,form</field>
    </record>

