<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Registro SIG para el reporte de Encuesta de Satisfaccion
            (BC-GC-FR-16). El layout del reporte consulta este registro
            via biocreto.documento.control.get_control_for_qweb('satisfaccion').

            El registro de RECLAMO (BC-GC-FR-03) se siembra en el
            prompt 2 (modulo biocreto_encuestas_reporte para reclamo).

            noupdate=1 para no machacar cambios manuales de version/
            fecha por parte del cliente.
            fecha por parte del cliente.
        -->
        <record id="sig_encuesta_satisfaccion" model="biocreto.documento.control">
            <field name="name">Encuesta de Satisfacción del Servicio</field>
            <field name="codigo">BC-GC-FR-16</field>
            <field name="codigo_documento">satisfaccion</field>
            <field name="version">01</field>
            <field name="fecha_version" eval="'2025-12-04'"/>
            <field name="descripcion">Formato de la encuesta de satisfacción del servicio prestado por BIOCRETO al cliente. Mide la conformidad respecto a atención, competencias técnicas, precio, puntualidad y satisfacción general.</field>
        </record>

        <!--
            v19.0.1.5.0 — Registro SIG para el reporte de Reclamo
            (BC-GC-FR-03). El layout consulta este registro via
            biocreto.documento.control.get_control_for_qweb('reclamo').
        -->
        <record id="sig_encuesta_reclamo" model="biocreto.documento.control">
            <field name="name">Encuesta de Sugerencias, Quejas y Reclamos</field>
            <field name="codigo">BC-GC-FR-03</field>
            <field name="codigo_documento">reclamo</field>
            <field name="version">01</field>
            <field name="fecha_version" eval="'2025-11-25'"/>
            <field name="descripcion">Formato para el registro de sugerencias, quejas y reclamos de los clientes de BIOCRETO. Incluye motivo, descripción y firma del cliente.</field>
        </record>
    </data>
</odoo>
