<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        ============================================================
        Body del reporte de Encuesta de Reclamo (BC-GC-FR-03)
        ============================================================
        REUSA el mismo encuesta_layout que satisfaccion (header/footer/
        SIG cuadrito/@page). Este body provee titulo + datos superiores
        (OV + fecha firma reclamo) + preguntas + delega al
        pie_legal_firma para Ley 29733 + firma de reclamo.

        Diferencias con satisfaccion:
          - sig_codigo='reclamo' -> BC-GC-FR-03 V01 25/11/2025 en el
            cuadrito del header.
          - Body itera las 2 preguntas del reclamo (multiple_choice
            con "Otros" + text_box).
          - `_biocreto_campos_firma()` devuelve el set de reclamo
            (`biocreto_firma_reclamo`, `_por`, `_fecha`) para el pie.

        Iterador identico al de satisfaccion. Como el `choice_block` YA
        maneja el "Otros" comentable de multiple_choice (recon Fase 4 F)
        y el `text_block` YA maneja text_box, no hay logica especifica.
    -->
    <template id="report_encuesta_reclamo_body">
        <t t-set="survey" t-value="user_input.survey_id"/>
        <t t-set="f" t-value="user_input._biocreto_campos_firma()"/>
        <t t-set="fecha_arriba" t-value="user_input[f[2]] if f[2] and user_input[f[2]] else user_input.create_date"/>

        <h1 class="doc-title-encuesta" t-out="survey.title"/>

        <div class="datos-superiores">
            <div class="dato-col">
                <span class="lbl">Orden de venta:</span>
                <span class="val" t-out="(user_input.sale_order_id and user_input.sale_order_id.name) or '-'"/>
            </div>
            <div class="dato-col">
                <span class="lbl">Fecha:</span>
                <span class="val" t-out="fecha_arriba.strftime('%d/%m/%Y') if fecha_arriba else '-'"/>
            </div>
        </div>

        <div class="biocreto-encuesta-preguntas">
            <t t-foreach="survey.question_and_page_ids" t-as="question">

                <t t-if="question.is_page">
                    <h2 class="biocreto-encuesta-seccion" t-out="question.title"/>
                </t>

                <t t-if="not question.is_page">
                    <t t-set="lines" t-value="user_input.user_input_line_ids.filtered(lambda l: l.question_id == question)"/>
                    <div class="biocreto-encuesta-pregunta">
                        <div class="biocreto-encuesta-pregunta-titulo">
                            <span t-out="question.title"/><t t-if="question.constr_mandatory"><span class="text-danger"> *</span></t>
                        </div>

                        <t t-if="question.question_type in ('simple_choice', 'multiple_choice')">
                            <t t-call="biocreto_encuestas_reporte.choice_block"/>
                        </t>
                        <t t-if="question.question_type == 'text_box'">
                            <t t-call="biocreto_encuestas_reporte.text_block"/>
                        </t>
                        <t t-if="question.question_type == 'char_box'">
                            <t t-call="biocreto_encuestas_reporte.text_block"/>
                        </t>
                    </div>
                </t>

            </t>
        </div>

        <t t-call="biocreto_encuestas_reporte.pie_legal_firma"/>
    </template>


    <!--
        v19.0.2.0.0 — El template raiz `report_encuesta_reclamo_document`
        fue ELIMINADO. Ahora el reporte es unico y ramifica en
        `report_encuesta_document` (dispatcher). Este archivo conserva
        SOLO el body (`report_encuesta_reclamo_body`).
    -->

</odoo>
