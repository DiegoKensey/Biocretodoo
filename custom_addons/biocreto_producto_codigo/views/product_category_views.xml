<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_category_form_biocreto_prefijo" model="ir.ui.view">
        <field name="name">product.category.form.biocreto.prefijo</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="biocreto_prefijo" placeholder="EPP"/>
            </xpath>
        </field>
    </record>

    <record id="product_category_list_biocreto_prefijo" model="ir.ui.view">
        <field name="name">product.category.list.biocreto.prefijo</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='display_name']" position="after">
                <field name="biocreto_prefijo"/>
            </xpath>
        </field>
    </record>

</odoo>
