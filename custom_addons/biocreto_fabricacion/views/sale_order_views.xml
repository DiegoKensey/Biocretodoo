<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Cambios cosmeticos en los stat buttons del form de sale.order:
          1) action_view_mrp_production: icono fa-wrench -> fa-industry.
          2) action_view_delivery: icono fa-truck -> SVG mixer inline.

        Ambos botones viven en vistas de addons nativos (sale_mrp y sale_stock).
        Heredamos de esas vistas (no de la base sale.view_order_form) para que
        el xpath encuentre los botones sin ambigüedad.
    -->

    <!-- 1) MRP: solo cambio de atributo icon -->
    <record id="sale_order_form_mrp_biocreto" model="ir.ui.view">
        <field name="name">sale.order.form.mrp.biocreto</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_mrp.sale_order_form_mrp"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_mrp_production']" position="attributes">
                <attribute name="icon">fa-industry</attribute>
            </xpath>
        </field>
    </record>

    <!-- 2) Delivery: icono fa-truck -> SVG mixer inline, herencia minima.
         El boton nativo NO tiene <i> en el arch: el icono sale del atributo
         icon="fa-truck" y ViewButton genera el <i> en runtime (view_button.js:25,
         solo acepta classes FontAwesome — no admite SVG). Via minima:
           a) quitar el atributo icon (ViewButton no renderea <i> si icon es falsy);
           b) insertar el <span> SVG antes del <field name="delivery_count">.
         El <button> y su <field statinfo string="Delivery"> nativos quedan
         intactos, asi la traduccion es_PE "Entrega" del .po de sale_stock
         sigue aplicando (un replace crearia un term nuevo sin traduccion). -->
    <record id="sale_order_form_delivery_biocreto" model="ir.ui.view">
        <field name="name">sale.order.form.delivery.biocreto</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_stock.view_order_form_inherit_sale_stock"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_view_delivery']" position="attributes">
                <attribute name="icon"/>
            </xpath>
            <xpath expr="//button[@name='action_view_delivery']/field[@name='delivery_count']" position="before">
                <span class="o_button_icon o_biocreto_icon_mixer">
                    <svg xmlns="http://www.w3.org/2000/svg"
                         viewBox="0.45 7.28 49.1 31.66" fill="currentColor">
                        <path d="M45.95,29.6c.09.1.9-.07,1.23.76.23.56.23,2.27.03,2.84-.36,1.04-1.31.84-2.14.82-.09-1.64-.54-3.2-1.62-4.39-3.08-3.38-8.35-1.55-9.21,3.07-.04.22-.05,1.24-.13,1.32-.06.06-.98-.03-1.18,0,.13-3.84-3.08-6.79-6.51-6.01-2.6.59-4.41,3.09-4.34,6.01h-6.81c.1-4.4-3.92-7.4-7.63-5.61-2.02.97-3.29,3.18-3.22,5.61-.98-.17-3.09.45-3.69-.55-.35-.58-.36-2.51-.1-3.13s.71-.66,1.24-.82l.02-7.97,5.51-9.53.24-.17,8.14.05,2.57,6.48c.05.11.11.17.23.17.1,0,1.73-.66,1.79-.75.12-.59.08-1.28.17-1.87,1.14-7.69,10.91-8.84,16.59-8.63l11.18,2.39,1.24,9.41-9.87,5.82-2.7.99h8.97c.09.46-.12,3.55,0,3.68ZM10.74,14.99h-2.12l-3.21,5.95h5.33v-5.95Z"/>
                        <path d="M39.59,28.79c5.88,0,6.09,9.5.59,10.11-6.55.73-6.95-10.11-.59-10.11ZM39.42,31.57c-2.74.3-2.43,5.06.66,4.51,2.34-.41,1.95-4.8-.66-4.51Z"/>
                        <path d="M27.47,28.77c5.91-.05,6.17,9.58.57,10.13-6.55.64-6.82-10.08-.57-10.13ZM27.29,31.57c-2.66.32-2.38,4.98.65,4.51,2.44-.37,2.04-4.83-.65-4.51Z"/>
                        <path d="M9.82,28.77c5.87-.05,6.18,9.58.57,10.13-6.56.64-6.82-10.08-.57-10.13ZM9.64,31.57c-2.68.32-2.37,4.97.65,4.51,2.42-.37,2.05-4.83-.65-4.51Z"/>
                    </svg>
                </span>
            </xpath>
        </field>
    </record>

</odoo>
