<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="biocreto_fabricacion.PlantaOnboarding">
    <div class="o_biocreto_onboarding">
        <div class="o_biocreto_onboarding_content">
            <img src="/biocreto_fabricacion/static/img/draw_planta.svg"
                 alt="Planta BIOCRETO"
                 class="o_biocreto_onboarding_img"/>
            <div class="o_biocreto_onboarding_action">
                <button class="btn btn-primary btn-lg"
                        t-on-click="() =&gt; props.onActivate()">
                    Active su centro de trabajo
                </button>
            </div>
        </div>
    </div>
</t>

</templates>
