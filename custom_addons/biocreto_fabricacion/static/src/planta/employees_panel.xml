<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="biocreto_fabricacion.EmployeesPanel">
    <aside class="o_biocreto_employees_panel">
        <div class="o_biocreto_employees_header d-flex justify-content-between align-items-center p-2 border-bottom">
            <h6 class="mb-0">
                <i class="fa fa-users me-2"/> Operadores
            </h6>
            <button class="btn btn-sm btn-link p-1"
                    t-on-click="() =&gt; props.onClose()">
                <i class="fa fa-times"/>
            </button>
        </div>
        <div class="o_biocreto_employees_body p-2">
            <div t-if="state.loading" class="text-center text-muted p-3">
                <i class="fa fa-spinner fa-spin"/>
            </div>
            <div t-else="">
                <div t-foreach="state.all" t-as="e" t-key="e.id"
                     class="o_biocreto_employee d-flex align-items-center py-1 px-2 rounded"
                     t-att-class="isConnected(e.id) ? 'bg-success-subtle' : ''"
                     t-on-click="() =&gt; this.toggleConnect(e)">
                    <i class="fa fa-user-circle me-2"
                       t-att-class="isConnected(e.id) ? 'text-success' : 'text-muted'"/>
                    <span class="flex-grow-1" t-out="e.name"/>
                    <span t-if="e.id === state.adminId"
                          class="badge text-bg-primary ms-2">Activo</span>
                    <span t-elif="isConnected(e.id)"
                          class="badge text-bg-success ms-2">Conectado</span>
                </div>
                <div t-if="!state.all.length" class="text-center text-muted p-3 small">
                    Sin empleados cargados.
                </div>
            </div>
        </div>
    </aside>
</t>

</templates>
