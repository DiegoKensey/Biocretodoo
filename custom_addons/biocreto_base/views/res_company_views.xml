<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_biocreto" model="ir.ui.view">
        <field name="name">res.company.form.biocreto</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_info']" position="inside">
                <group string="BIOCRETO" name="biocreto_plant_info">
                    <field name="plant_code"/>
                    <field name="manager_id"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
