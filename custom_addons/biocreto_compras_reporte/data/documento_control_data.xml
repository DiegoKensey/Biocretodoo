<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!--
            Registro SIG del reporte de Solicitud de Cotizacion.
            Consultado desde el QWeb via
              env['biocreto.documento.control'].get_control_for_qweb('compras_sc')
            que devuelve {codigo, version, fecha_version}.

            noupdate="1": si el registro ya existe con esta xml_id (ej.
            porque el cliente lo creo manualmente antes de instalar el
            reporte), los -u posteriores NO lo pisan.
        -->
        <record id="documento_sc_compras" model="biocreto.documento.control">
            <field name="name">Solicitud de Cotizacion - Compras</field>
            <field name="codigo">BC-GL-FR-05</field>
            <field name="codigo_documento">compras_sc</field>
            <field name="version">01</field>
            <field name="fecha_version" eval="'2026-07-08'"/>
        </record>

        <!--
            v19.0.2.0.0: registro SIG para el reporte de Orden de Compra.
            Consultado desde el QWeb via
              env['biocreto.documento.control'].get_control_for_qweb('compras_oc')
            en sc_layout (ruteo por o.biocreto_sc_es_oc()).
        -->
        <record id="documento_oc_compras" model="biocreto.documento.control">
            <field name="name">Orden de Compra</field>
            <field name="codigo">BC-GL-FR-19</field>
            <field name="codigo_documento">compras_oc</field>
            <field name="version">01</field>
            <field name="fecha_version" eval="'2026-07-08'"/>
        </record>

    </data>
</odoo>
